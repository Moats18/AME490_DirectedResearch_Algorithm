            RowBox[{"l", "<=", 
             RowBox[{"Length", "[", "indexLists", "]"}]}], ",", 
            RowBox[{"l", "++"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"polygonsX", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Mod", "[", 
                    RowBox[{"l", ",", "2"}], "]"}], "==", "0"}], ",", "Blue", 

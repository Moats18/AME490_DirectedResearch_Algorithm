         RowBox[{
          RowBox[{"translation", "=", 
           RowBox[{
            RowBox[{"i", "*", "xl1"}], "+", 
            RowBox[{"j", "*", "xl2"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{

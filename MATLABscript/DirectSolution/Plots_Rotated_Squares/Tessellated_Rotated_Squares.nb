Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Import", " ", "and", " ", "flatten", " ", "data"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<y.csv\>\"", ",", "\"\<CSV\>\""}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yO", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<yOpt.csv\>\"", ",", "\"\<CSV\>\""}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<x.csv\>\"", ",", "\"\<CSV\>\""}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xO", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<xOpt.csv\>\"", ",", "\"\<CSV\>\""}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Split", " ", "into", " ", "9", " ", "pairs"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yN", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"y", ",", "3"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yOpt", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"yO", ",", "3"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xN", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"x", ",", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xOpt", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"xO", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "panels", " ", "indices"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"indexLists", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3", ",", "12"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4", ",", " ", "5", ",", " ", "6"}], "}"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "7", ",", " ", "8", ",", " ", "9"}], "}"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"9", ",", " ", "10", ",", " ", "11", ",", " ", "12"}], 
        "}"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yl1", "=", 
     RowBox[{
      RowBox[{"yN", "[", 
       RowBox[{"[", "11", "]"}], "]"}], "-", 
      RowBox[{"yN", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yl2", "=", 
     RowBox[{
      RowBox[{"yN", "[", 
       RowBox[{"[", "5", "]"}], "]"}], "-", 
      RowBox[{"yN", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"polygonsY", "=", 
     RowBox[{"{", "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Initialize", " ", "an", " ", "empty", " ", "list"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Number", " ", "of", " ", "repetitions", " ", "along", " ", "each", " ", 
     "lattice", " ", "direction"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", "10"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Adjust", " ", "for", " ", "desired", " ", "tiling", " ", "range"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "<=", "n"}], ",", 
      RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "n"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"translation", "=", 
           RowBox[{
            RowBox[{"i", "*", "yl1"}], "+", 
            RowBox[{"j", "*", "yl2"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"l", "=", "1"}], ",", 
            RowBox[{"l", "<=", 
             RowBox[{"Length", "[", "indexLists", "]"}]}], ",", 
            RowBox[{"l", "++"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"polygonsY", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Mod", "[", 
                    RowBox[{"l", ",", "2"}], "]"}], "==", "0"}], ",", "Blue", 
                  ",", "Red"}], "]"}], ",", 
                RowBox[{"Polygon", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "+", "translation"}], "&"}], "/@", 
                  RowBox[{"yOpt", "[", 
                   RowBox[{"[", 
                    RowBox[{"indexLists", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "]"}], "]"}]}], "]"}]}], 
               "}"}]}], "]"}]}], "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "the", " ", "3", "D", " ", "graphics"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Graphics3D", "[", "polygonsY", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polygonsX", "=", 

                  RowBox[{
                   RowBox[{"Mod", "[", 
                    RowBox[{"l", ",", "2"}], "]"}], "==", "0"}], ",", "Blue", 
                  ",", "Red"}], "]"}], ",", 
                RowBox[{"Polygon", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "+", "translation"}], "&"}], "/@", 
                  RowBox[{"yOpt", "[", 
                   RowBox[{"[", 
                    RowBox[{"indexLists", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "]"}], "]"}]}], "]"}]}], 
               "}"}]}], "]"}]}], "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";"}],

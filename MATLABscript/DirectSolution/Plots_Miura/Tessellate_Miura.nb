Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Import", " ", "and", " ", "flatten", " ", "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<y.csv\>\"", ",", "\"\<CSV\>\""}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yO", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<yOpt.csv\>\"", ",", "\"\<CSV\>\""}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<x.csv\>\"", ",", "\"\<CSV\>\""}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xO", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<xOpt.csv\>\"", ",", "\"\<CSV\>\""}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Split", " ", "into", " ", "9", " ", "pairs"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yN", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"y", ",", "3"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yOpt", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"yO", ",", "3"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xN", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"x", ",", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xOpt", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"xO", ",", "2"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "panels", " ", "indices"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"indexLists", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "5", ",", "6"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "5", ",", "8", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "4", ",", "5"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"yl1", "=", 
     RowBox[{
      RowBox[{"yN", "[", 
       RowBox[{"[", "7", "]"}], "]"}], "-", 
      RowBox[{"yN", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yl2", "=", 
     RowBox[{
      RowBox[{"yN", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "-", 
      RowBox[{"yN", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polygonsY", "=", 
     RowBox[{"{", "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Initialize", " ", "an", " ", "empty", " ", "list"}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Number", " ", "of", " ", "repetitions", " ", "along", " ", "each", " ", 
     "lattice", " ", "direction"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "3"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Adjust", " ", "for", " ", "desired", " ", "tiling", " ", "range"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "<=", "n"}], ",", 
      RowBox[{"j", "++"}], ",", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "n"}], ",", 
         RowBox[{"i", "++"}], ",", 
         RowBox[{
          RowBox[{"translation", "=", 
           RowBox[{
            RowBox[{"i", "*", "yl1"}], "+", 
            RowBox[{"j", "*", "yl2"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
